#!/bin/bash

# Nigeria-specific rollout for the results-packages cutover: everything long
# runs DETACHED on wb-server (docker exec -d), so no ssh session needs to
# survive. Your terminal is needed for minutes only; check back with `status`.
#
#   ./rollout_nigeria start                 # preflight + update image + health
#                                           # + launch detached backfill of ALL
#                                           # projects missing a package
#   ./rollout_nigeria status                # backfill/rig progress + verdicts
#   ./rollout_nigeria rig [<projectId>...]  # launch detached rig runs; with no
#                                           # args, gates the three ruled active
#                                           # projects (Bauchi, Nigeria General,
#                                           # NHSS — Tim, 2026-08-10)
#
# Differences from ./rollout_fleet, all deliberate (recorded in
# PLAN_RESULTS_RUNS.md):
#   - Backfill continues past a failing project (per-project isolation) and
#     reports OK/FAILED per project; re-running `start` retries only projects
#     still missing a package.
#   - The rig gates ONLY the named active projects. Obsolete projects serve
#     from faithful package copies with parity untested — accepted because the
#     engine is proven green on the rest of the fleet. The rig's "N of M
#     projects gated" line keeps this explicit.
#   - MIN_FREE_GB defaults to 250 (Nigeria-scale packages).

set -u -o pipefail

SSH_HOST="wb-server"
INSTANCE="nigeria"
HEALTH_TIMEOUT_SECONDS="${HEALTH_TIMEOUT_SECONDS:-300}"
MIN_FREE_GB="${MIN_FREE_GB:-250}"
DENO_FLAGS="-A --unstable-broadcast-channel --unstable-raw-imports -c deno.json"
REMOTE_DIR="/tmp/rollout_nigeria"

# The ruled active-project gate set (Tim, 2026-08-10):
#   06f6e66f… Bauchi State
#   5e27143f… Nigeria General Project
#   1e09dfaf… NATIONAL HEALTH SECTOR SCORECARD (NHSS)
DEFAULT_RIG_PROJECTS="06f6e66f-f0af-4195-b45f-ddf5d8705eff 5e27143f-d8bd-49c0-a19f-ce583449766a 1e09dfaf-b73f-455e-abbd-0238ee3843ba"

# Pinned to the cutover image that carries the CSV quote/escape fix — REQUIRED
# for Nigeria's backfill (facility names with embedded quotes) — and the full
# legacy_gap/broken_config rig classifications.
VERSION="1.66.5"
IMAGE_TAG="timroberton/comb:wb-fastr-server-v$VERSION"

SSH_OPTS=(-o ConnectTimeout=15 -o ControlMaster=auto -o "ControlPath=$HOME/.ssh/cm-%r@%h:%p" -o ControlPersist=15m)
sshx() {
    local attempt rc
    for attempt in 1 2 3; do
        command ssh "${SSH_OPTS[@]}" "$@"
        rc=$?
        [ "$rc" -ne 255 ] && return "$rc"
        echo "  (ssh connection failed — retry $attempt/3 in 15s)" >&2
        sleep 15
    done
    return 255
}

psql_main() {
    sshx "$SSH_HOST" "docker exec ${INSTANCE}-postgres psql -U postgres -d main -t -A -c \"$1\""
}

usage() {
    echo "Usage: ./rollout_nigeria start | status | rig [<projectId>...]"
    echo "  rig with no args gates the ruled set: Bauchi, Nigeria General, NHSS"
    exit 1
}

[ "$#" -ge 1 ] || usage
CMD="$1"
shift

case "$CMD" in

start)
    echo "Nigeria rollout: $IMAGE_TAG"
    sshx "$SSH_HOST" "docker manifest inspect $IMAGE_TAG >/dev/null 2>&1" || {
        echo "ERROR: $IMAGE_TAG not on the registry — deploy it first (./deploy)."
        exit 1
    }
    SHOW_JSON=$(sshx "$SSH_HOST" "wb c show $INSTANCE --json") || { echo "ERROR: wb c show failed"; exit 1; }
    PORT=$(echo "$SHOW_JSON" | jq -r '.port')
    [ -n "$PORT" ] && [ "$PORT" != "null" ] || { echo "ERROR: no port in: $SHOW_JSON"; exit 1; }

    SANDBOX_SRC=$(sshx "$SSH_HOST" "docker inspect $INSTANCE --format '{{range .Mounts}}{{if eq .Destination \"/app/sandbox\"}}{{.Source}}{{end}}{{end}}'")
    FREE_GB=$(sshx "$SSH_HOST" "df -BG --output=avail '$SANDBOX_SRC' | tail -1 | tr -dc '0-9'")
    echo "Port $PORT; data volume free ${FREE_GB}G (min ${MIN_FREE_GB}G)"
    [ "$FREE_GB" -ge "$MIN_FREE_GB" ] || { echo "ERROR: insufficient disk"; exit 1; }

    CURRENT_IMAGE=$(sshx "$SSH_HOST" "docker inspect --format '{{.Config.Image}}' $INSTANCE 2>/dev/null" || true)
    if [ "$CURRENT_IMAGE" = "$IMAGE_TAG" ]; then
        echo "Already on $VERSION — skipping update/restart"
    else
        sshx "$SSH_HOST" "wb c update $INSTANCE --server $VERSION && wb restart $INSTANCE" || {
            echo "ERROR: update failed"; exit 1;
        }
    fi

    echo "Polling health (timeout ${HEALTH_TIMEOUT_SECONDS}s)..."
    # Command-argument form (not heredoc) so the sshx retry is safe.
    sshx "$SSH_HOST" "deadline=\$((SECONDS + $HEALTH_TIMEOUT_SECONDS)); while [ \$SECONDS -lt \$deadline ]; do body=\$(curl -sfm 5 http://localhost:$PORT/health_check || true); case \"\$body\" in *'\"running\":true'*) exit 0;; esac; sleep 5; done; exit 1" || {
        sshx "$SSH_HOST" "docker logs --tail 60 $INSTANCE" || true
        echo "ERROR: no healthy /health_check within ${HEALTH_TIMEOUT_SECONDS}s"
        exit 1
    }
    echo "Healthy."

    MISSING_IDS=$(psql_main "SELECT id FROM projects WHERE status='ready' AND run_id IS NULL") || exit 1
    if [ -z "$MISSING_IDS" ]; then
        echo "Backfill: every ready project already has a package — nothing to launch."
        exit 0
    fi
    COUNT=$(echo "$MISSING_IDS" | wc -l | tr -d ' ')
    IDS_ONELINE=$(echo "$MISSING_IDS" | tr '\n' ' ')
    echo "Launching DETACHED backfill of $COUNT project(s) — safe to close this terminal."
    # Single-quoted payload: everything inside expands in the CONTAINER shell,
    # never on wb-server (the earlier EXIT:$? lesson). Per-project isolation:
    # a failing project is recorded and the driver moves on.
    sshx "$SSH_HOST" "docker exec -d -w /app $INSTANCE bash -c 'mkdir -p $REMOTE_DIR; echo \"DRIVER START \$(date -u +%FT%TZ)\" >> $REMOTE_DIR/backfill.log; ok=0; failed=0; for id in $IDS_ONELINE; do if deno run $DENO_FLAGS backfill_runs.ts --project \$id >> $REMOTE_DIR/backfill.log 2>&1; then ok=\$((ok+1)); echo \"DRIVER OK \$id\" >> $REMOTE_DIR/backfill.log; else failed=\$((failed+1)); echo \"DRIVER FAILED \$id\" >> $REMOTE_DIR/backfill.log; fi; done; echo \"DRIVER DONE ok=\$ok failed=\$failed\" >> $REMOTE_DIR/backfill.log'" || {
        echo "ERROR: could not launch detached backfill"; exit 1;
    }
    echo "Launched. Check progress with: ./rollout_nigeria status"
    ;;

status)
    TOTAL=$(psql_main "SELECT count(*) FROM projects WHERE status='ready'")
    WITH_RUN=$(psql_main "SELECT count(*) FROM projects WHERE status='ready' AND run_id IS NOT NULL")
    echo "Packages attached: $WITH_RUN of $TOTAL ready projects"
    echo ""
    echo "── Backfill driver (last 12 lines) ──"
    sshx "$SSH_HOST" "docker exec $INSTANCE sh -c 'grep \"^DRIVER\" $REMOTE_DIR/backfill.log 2>/dev/null | tail -12 || echo \"(not started)\"'"
    echo ""
    echo "── Rig runs ──"
    sshx "$SSH_HOST" "docker exec $INSTANCE sh -c 'cat $REMOTE_DIR/rig_status 2>/dev/null || echo \"(none launched)\"; for f in $REMOTE_DIR/rig_*.log; do [ -e \"\$f\" ] || continue; v=\$(grep -a PARITY \"\$f\" | tail -1); echo \"\$(basename \$f): \${v:-still running}\"; done'"
    ;;

rig)
    if [ "$#" -ge 1 ]; then IDS="$*"; else IDS="$DEFAULT_RIG_PROJECTS"; fi
    echo "Launching DETACHED rig for: $IDS"
    sshx "$SSH_HOST" "docker exec -d -w /app $INSTANCE bash -c 'mkdir -p $REMOTE_DIR; for id in $IDS; do deno run $DENO_FLAGS validate_results_runs_parity.ts --run --project \$id > $REMOTE_DIR/rig_\$id.log 2>&1; echo \"\$id EXIT=\$?\" >> $REMOTE_DIR/rig_status; done; echo \"RIG DRIVER DONE\" >> $REMOTE_DIR/rig_status'" || {
        echo "ERROR: could not launch detached rig"; exit 1;
    }
    echo "Launched — safe to close this terminal. Check with: ./rollout_nigeria status"
    ;;

*)
    usage
    ;;
esac
