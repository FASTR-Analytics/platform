#!/bin/bash

set -e

# Store original working directory and start time
START_TIME=$(date +%s)
ORIGINAL_DIR=$(pwd)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLIENT_DIR="$SCRIPT_DIR/client"
SERVER_DIR="$SCRIPT_DIR"

# Read version from VERSION file
if [ ! -f VERSION ]; then
    echo "ERROR: VERSION file not found!"
    exit 1
fi

ORIGINAL_VERSION=$(cat VERSION)
echo "Current version: $ORIGINAL_VERSION"

# report-forge is a git submodule. The image is built from its working tree
# and the deploy commit records its HEAD, so both must be a commit its own
# repository has: otherwise production runs code that is in no commit, and a
# fresh clone cannot check the recorded commit out.
if [ -d report-forge ]; then
    if [ -n "$(git -C report-forge status --porcelain)" ]; then
        echo "ERROR: report-forge has uncommitted changes. Commit and push them first."
        exit 1
    fi
    if ! git -C report-forge fetch -q origin; then
        echo "ERROR: could not reach report-forge's remote to check its commit is pushed."
        exit 1
    fi
    if [ -z "$(git -C report-forge branch -r --contains HEAD)" ]; then
        echo "ERROR: report-forge's commit is not on its remote. Push it first (git -C report-forge push)."
        exit 1
    fi
fi

# ── Every question the deploy asks, asked here ──────────────────────────────
# Nothing below this block reads stdin: once these are answered the deploy
# runs to completion unattended, and a failure aborts rather than asking.
# The version is only DECIDED here; the VERSION file is written at the end,
# after the last step that can fail (see "Write the VERSION file" below).

echo "Is this an ad-hoc/testing deploy? (y/n)"
read -r ADHOC_DEPLOY

if [ "$ADHOC_DEPLOY" = "y" ] || [ "$ADHOC_DEPLOY" = "Y" ]; then
    ADHOC_MODE=true
    echo "Enter ad-hoc tag name (e.g., test-feature-x, debug-2024-01-28):"
    read -r ADHOC_TAG
    if [ -z "$ADHOC_TAG" ]; then
        echo "ERROR: Ad-hoc tag cannot be empty"
        exit 1
    fi
    VERSION="$ADHOC_TAG"
else
    ADHOC_MODE=false

    MAJOR=$(echo "$ORIGINAL_VERSION" | cut -d. -f1)
    MINOR=$(echo "$ORIGINAL_VERSION" | cut -d. -f2)
    PATCH=$(echo "$ORIGINAL_VERSION" | cut -d. -f3)

    # The major version is not bumped from here.
    echo "Bump the minor version $ORIGINAL_VERSION → $MAJOR.$((MINOR + 1)).0? (y/n)"
    read -r BUMP_MINOR

    if [ "$BUMP_MINOR" = "y" ] || [ "$BUMP_MINOR" = "Y" ]; then
        MINOR=$((MINOR + 1))
        PATCH=0
    else
        echo "Bump the patch version $ORIGINAL_VERSION → $MAJOR.$MINOR.$((PATCH + 1))? (y/n)"
        read -r BUMP_PATCH

        if [ "$BUMP_PATCH" = "y" ] || [ "$BUMP_PATCH" = "Y" ]; then
            PATCH=$((PATCH + 1))
        fi
    fi

    VERSION="$MAJOR.$MINOR.$PATCH"
fi

echo "Validate migrations and queries? (y/n)"
read -r RUN_TESTS_ANSWER

if [ "$RUN_TESTS_ANSWER" = "y" ] || [ "$RUN_TESTS_ANSWER" = "Y" ]; then
    RUN_TESTS=true
else
    RUN_TESTS=false
fi

# What was just answered, so the run can be left alone from here.
echo ""
if [ "$ADHOC_MODE" = "true" ]; then
    echo "  Ad-hoc deploy:  $VERSION (VERSION file untouched, no rebase)"
elif [ "$VERSION" = "$ORIGINAL_VERSION" ]; then
    echo "  Version:        $VERSION (unchanged)"
else
    echo "  Version:        $ORIGINAL_VERSION → $VERSION"
fi
echo "  Validate:       $RUN_TESTS"
echo "  Typecheck and protocol validation always run."
echo ""
echo "No further questions: the deploy now runs to completion."
echo ""

# Cleanup on failure. The VERSION file is written at the very end, so this
# only has something to restore when the failure came after that write (the
# git steps); it is unconditional because restoring the value it already
# holds costs nothing.
cleanup() {
    echo "ERROR: Deployment failed! Restoring original version..."
    echo "$ORIGINAL_VERSION" > VERSION

    # Restore client_dist backup if it exists
    if [ -d "$SERVER_DIR/client_dist.backup" ]; then
        echo "Restoring client_dist backup..."
        rm -rf "$SERVER_DIR/client_dist"
        mv "$SERVER_DIR/client_dist.backup" "$SERVER_DIR/client_dist"
    fi
    
    cd "$ORIGINAL_DIR"
    exit 1
}

# Set trap for cleanup on failure
trap cleanup ERR

# Run typecheck first
echo "Running typecheck..."
if ! deno task typecheck; then
    echo "ERROR: Typecheck failed!"
    exit 1
fi

# Prerequisites check
echo "Checking prerequisites..."
command -v npm >/dev/null 2>&1 || { echo "ERROR: npm not found!"; exit 1; }
command -v docker >/dev/null 2>&1 || { echo "ERROR: docker not found!"; exit 1; }
command -v git >/dev/null 2>&1 || { echo "ERROR: git not found!"; exit 1; }

# Find crane (used to push from the WSL distro's network instead of the
# Docker Desktop VM, whose upload path is throttled ~5x: measured 0.5 MB/s
# vs 2.4 MB/s on 2026-07-02, turning a ~30s push into ~10 min)
CRANE=$(command -v crane 2>/dev/null || true)
if [ -z "$CRANE" ] && [ -x "$HOME/.local/bin/crane" ]; then
    CRANE="$HOME/.local/bin/crane"
fi
if [ -z "$CRANE" ]; then
    echo "WARNING: crane not found, falling back to 'docker push', which is"
    echo "slow on machines where Docker Desktop throttles VM upload."
    echo "Install: https://github.com/google/go-containerregistry/releases"
fi

# Check if docker is running and logged in
if ! docker info >/dev/null 2>&1; then
    echo "ERROR: Docker is not running!"
    exit 1
fi

if ! docker info 2>/dev/null | grep -q "Username:"; then
    echo "WARNING: You may not be logged into Docker Hub. This could cause push to fail."
    echo "Run 'docker login' if needed."
fi

# Always run protocol validation (fast, no Docker needed). It aborts the
# deploy: overriding a failed gate is a decision, and every decision in this
# script is made before the run starts.
if ! "$SCRIPT_DIR/validate_protocols"; then
    echo "ERROR: Protocol validation failed (violations, or the validator itself errored)."
    exit 1
fi

if [ "$RUN_TESTS" = "true" ]; then
    if ! "$SCRIPT_DIR/validate_migrations"; then
        echo "ERROR: Migration validation failed!"
        exit 1
    fi

    if ! "$SCRIPT_DIR/validate_queries"; then
        echo "ERROR: Query validation failed!"
        exit 1
    fi
fi

# Build client
if [ ! -d "$CLIENT_DIR" ]; then
    echo "ERROR: Client directory not found: $CLIENT_DIR"
    exit 1
fi

echo "Building client HTML..."
cd "$CLIENT_DIR"

if ! npm run build; then
    echo "ERROR: Client build failed!"
    exit 1
fi

# Validate client build output
if [ ! -d "$CLIENT_DIR/dist" ]; then
    echo "ERROR: Client build output not found at $CLIENT_DIR/dist"
    exit 1
fi

if [ ! "$(ls -A "$CLIENT_DIR/dist")" ]; then
    echo "ERROR: Client build output directory is empty!"
    exit 1
fi

cd "$SERVER_DIR"

# Backup existing client_dist directory
if [ -d "$SERVER_DIR/client_dist" ]; then
    echo "Backing up existing client_dist directory..."
    rm -rf "$SERVER_DIR/client_dist.backup"
    cp -r "$SERVER_DIR/client_dist" "$SERVER_DIR/client_dist.backup"
fi

# Copy new client build
echo "Copying client build to server..."
rm -rf "$SERVER_DIR/client_dist"
cp -r "$CLIENT_DIR/dist" "$SERVER_DIR/client_dist"

echo "Client build completed successfully"

echo "Building Docker image with version: $VERSION"

# Build with single versioned tag
if ! docker build --platform linux/amd64 \
    -t timroberton/comb:wb-fastr-server-v$VERSION \
    .; then
    echo "ERROR: Docker build failed!"
    exit 1
fi

echo "Docker build completed successfully"
echo "Pushing versioned tag to Docker Hub..."

IMAGE_TAG="timroberton/comb:wb-fastr-server-v$VERSION"

if [ -n "$CRANE" ]; then
    # Export from the daemon and push with crane so the upload bypasses the
    # Docker Desktop VM. crane skips layers already on the registry.
    SAVE_TAR=$(mktemp /tmp/wb-fastr-deploy-XXXXXX.tar)
    echo "Exporting image from Docker daemon..."
    if ! docker save -o "$SAVE_TAR" "$IMAGE_TAG"; then
        rm -f "$SAVE_TAR"
        echo "ERROR: docker save failed for $IMAGE_TAG"
        exit 1
    fi
    echo "Pushing $IMAGE_TAG with crane..."
    if ! "$CRANE" push "$SAVE_TAR" "$IMAGE_TAG"; then
        rm -f "$SAVE_TAR"
        echo "ERROR: Failed to push $IMAGE_TAG"
        exit 1
    fi
    rm -f "$SAVE_TAR"
else
    echo "Pushing $IMAGE_TAG..."
    if ! docker push "$IMAGE_TAG"; then
        echo "ERROR: Failed to push $IMAGE_TAG"
        exit 1
    fi
fi

echo "Docker image pushed successfully"

# Write the VERSION file, now that every step that can fail has passed: the
# build reads the version from this script's variable and the running server
# reads SERVER_VERSION from its environment, so nothing needed the file
# earlier and a failed deploy leaves the version it was.
if [ "$ADHOC_MODE" = "false" ] && [ "$VERSION" != "$ORIGINAL_VERSION" ]; then
    echo "$VERSION" > VERSION
    echo "Version bumped to: $VERSION"
fi

# Commit to git
echo "Committing changes to git..."
today=`date +%Y_%m_%d_%H_%M_%S`

if ! git add .; then
    echo "ERROR: Git add failed!"
    exit 1
fi

if [ "$ADHOC_MODE" = "true" ]; then
    COMMIT_MSG="Ad-hoc deploy: $VERSION at $today"
else
    COMMIT_MSG="Deploy version $VERSION at $today"
fi

if ! git commit -m "$COMMIT_MSG" --allow-empty; then
    echo "ERROR: Git commit failed!"
    exit 1
fi

# A GitHub Action generates a CHANGELOG_AUTO.txt commit on the remote after
# each push. This means the remote is almost always 1 commit ahead by the
# time we deploy again. We auto-rebase over changelog-only commits, but abort
# if there are any other unexpected commits on the remote.
# Skip this check for ad-hoc deploys: they intentionally diverge from main.
if [ "$ADHOC_MODE" = "false" ]; then
    git fetch origin main
    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main)

    if [ "$LOCAL" != "$REMOTE" ]; then
        echo "Remote has commits not yet local. Rebasing..."
        git log "$LOCAL..$REMOTE" --oneline
        if ! git pull --rebase; then
            echo "ERROR: Rebase failed!"
            exit 1
        fi
    fi
fi

if ! git push; then
    echo "ERROR: Git push failed!"
    exit 1
fi

# Clear trap and cleanup backup on successful completion
trap - ERR
if [ -d "$SERVER_DIR/client_dist.backup" ]; then
    echo "Removing client_dist backup (deployment successful)..."
    rm -rf "$SERVER_DIR/client_dist.backup"
fi

# Calculate duration
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
MINUTES=$((DURATION / 60))
SECONDS=$((DURATION % 60))

# Success banner
echo ""
echo -e "\033[92m"
echo "╔══════════════════════════════════════════════════════════════════════╗"
echo "║                                                                      ║"
if [ "$ADHOC_MODE" = "true" ]; then
    echo "║                   AD-HOC DEPLOYMENT SUCCESSFUL!                      ║"
else
    echo "║                      DEPLOYMENT SUCCESSFUL!                         ║"
fi
echo "║                                                                      ║"
echo "╠══════════════════════════════════════════════════════════════════════╣"
printf "║  Version:        %-51s ║\n" "$VERSION"
printf "║  Docker Image:   %-51s ║\n" "timroberton/comb:wb-fastr-server-v$VERSION"
echo "║                                                                      ║"
echo "║  Operations Completed:                                               ║"
if [ "$ADHOC_MODE" = "true" ]; then
    printf "║    - Version file left at %-42s ║\n" "$ORIGINAL_VERSION"
elif [ "$VERSION" = "$ORIGINAL_VERSION" ]; then
    printf "║    - Version kept at %-47s ║\n" "$ORIGINAL_VERSION"
else
    printf "║    - Version bumped from %-43s ║\n" "$ORIGINAL_VERSION to $VERSION"
fi
echo "║    - Client built successfully                                       ║"
echo "║    - Docker image built successfully                                 ║"
echo "║    - Docker image pushed to Docker Hub                               ║"
echo "║    - Changes committed to Git                                        ║"
echo "║    - Changes pushed to remote repository                             ║"
echo "║                                                                      ║"
printf "║  Duration: %-57s ║\n" "$MINUTES minutes $SECONDS seconds"
echo "╚══════════════════════════════════════════════════════════════════════╝"
echo -e "\033[0m"
echo ""
cd "$ORIGINAL_DIR"