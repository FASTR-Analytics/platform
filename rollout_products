#!/bin/bash

# Fleet rollout for the products restructure (PLAN_PRODUCTS_RESTRUCTURE
# step 13). Runs from the local machine; per instance it:
#
#   1. preflights: the instance exists, its runs volume has headroom, and the
#      operator confirms a NAMED status-api dump of `main` is on disk (the
#      rollback path is `./restore_main` with that dump plus the previous
#      image, and the previous image cannot boot after migration 092
#      without it)
#   2. points the instance at the target server image (wb c update / wb pull /
#      wb restart), whose boot runs migrations 000 to 092 and the instance
#      JSON transforms inside the boot transaction
#   3. polls /health_check until the server boots: a migration failure
#      fail-stops the boot, so an unhealthy instance means the consolidation
#      rolled back and the instance is still on its pre-restructure schema
#   4. post-checks: the project layer is gone (092 recorded, `projects`
#      dropped), every registry row has its detail row, and the product,
#      folder, slide and version counts match EXACTLY what
#      ./validate_consolidation.ts planned for that instance
#
# Failure policy: any failure HALTS the whole run. A post-check mismatch means
# the migration produced something other than what the gate approved, and
# every later instance would reproduce it. Rollback is `./restore_main` (the
# named dump plus the previous image), per instance.
#
# Usage:
#   ./rollout_products --expect rollout_logs/consolidation_plan.json <instance> [<instance>...]
#   ./rollout_products --expect rollout_logs/consolidation_plan.json --deploy sierraleone uganda
#
# DRY-RUN BY DEFAULT: without --deploy it preflights every instance, prints
# the counts it would verify, and touches nothing. --deploy is what updates
# images and runs the migration.
#
# Options:
#   --expect <file>   planned counts from ./validate_consolidation.ts --json
#                     (required; the gate's numbers, not re-derived ones)
#   --deploy          actually update, restart and post-check
#   --version <v>     server version to roll out (default: the VERSION file)
#   MIN_FREE_GB       runs-volume headroom, default 10
#   SKIP_BACKUP_CHECK=1  bypass the backup preflight (only for an instance
#                     whose dump you have verified by hand)

set -u -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SSH_HOST="wb-server"
HEALTH_TIMEOUT_SECONDS="${HEALTH_TIMEOUT_SECONDS:-600}"
MIN_FREE_GB="${MIN_FREE_GB:-10}"
SKIP_BACKUP_CHECK="${SKIP_BACKUP_CHECK:-0}"

# All remote calls go through one multiplexed ssh connection (ControlMaster):
# parallel terminals otherwise open enough concurrent handshakes to trip
# sshd's MaxStartups and get refused. Exit 255 (ssh-level failure, command
# never returned) is retried; remote command failures pass through untouched.
# -n: no call here feeds stdin, and without it ssh would read the file behind
# a `while read` loop and end the loop after its first line.
SSH_OPTS=(-o ConnectTimeout=15 -o ControlMaster=auto -o "ControlPath=$HOME/.ssh/cm-%r@%h:%p" -o ControlPersist=15m)
sshx() {
    local attempt rc
    for attempt in 1 2 3; do
        command ssh -n "${SSH_OPTS[@]}" "$@"
        rc=$?
        [ "$rc" -ne 255 ] && return "$rc"
        echo "  (ssh connection failed, retry $attempt/3 in 15s)" >&2
        sleep 15
    done
    return 255
}

usage() {
    echo "Usage: ./rollout_products --expect <plan.json> [--deploy] [--version <v>] <instance> [<instance>...]"
    echo "  e.g. ./rollout_products --expect rollout_logs/consolidation_plan.json sierraleone       # dry-run"
    echo "       ./rollout_products --expect rollout_logs/consolidation_plan.json --deploy sierraleone"
    exit 1
}

EXPECT_FILE=""
DEPLOY=false
VERSION=""
INSTANCES=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --expect) EXPECT_FILE="${2:-}"; shift 2 ;;
        --version) VERSION="${2:-}"; shift 2 ;;
        --deploy) DEPLOY=true; shift ;;
        -*) echo "ERROR: unknown option: $1"; usage ;;
        *) INSTANCES+=("$1"); shift ;;
    esac
done

[ -n "$EXPECT_FILE" ] || { echo "ERROR: --expect <plan.json> is required."; usage; }
[ -f "$EXPECT_FILE" ] || { echo "ERROR: no such plan file: $EXPECT_FILE"; exit 1; }
[ "${#INSTANCES[@]}" -ge 1 ] || usage
command -v jq >/dev/null 2>&1 || { echo "ERROR: jq not found."; exit 1; }

if [ -z "$VERSION" ]; then
    VERSION="$(cat "$SCRIPT_DIR/VERSION")"
fi
IMAGE_TAG="timroberton/comb:wb-fastr-server-v$VERSION"

LOG_DIR="rollout_logs/products-$VERSION-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$LOG_DIR"

# Mirror everything shown on the console into the run's log dir as well.
exec > >(tee -a "$LOG_DIR/console.log") 2>&1

fail() {
    local instance="$1" phase="$2" msg="$3"
    echo ""
    echo "ROLLOUT HALTED at instance '$instance', phase '$phase'"
    echo "  $msg"
    echo "  Logs: $LOG_DIR/"
    echo "  Instances completed before the halt: ${COMPLETED[*]:-none}"
    echo "  Rollback for a migrated instance is ./restore_main <instance>"
    echo "  <dump> --previous-version <v> --confirm (the named dump is NOT"
    echo "  optional: the previous image cannot boot after 092 without it)."
    exit 1
}

psql_main() {
    local instance="$1" query="$2"
    sshx "$SSH_HOST" "docker exec ${instance}-postgres psql -U postgres -d main -t -A -c \"$query\""
}

expected() {
    local instance="$1" key="$2"
    jq -r --arg i "$instance" --arg k "$key" '.[$i][$k] // empty' "$EXPECT_FILE"
}

check_count() {
    local instance="$1" label="$2" query="$3" want="$4"
    local got
    got=$(psql_main "$instance" "$query") ||
        fail "$instance" "post-check" "could not query $label"
    if [ "$got" != "$want" ]; then
        fail "$instance" "post-check" "$label: got $got, the dry-run planned $want"
    fi
    printf "    %-20s %s\n" "$label" "$got"
}

check_zero() {
    local instance="$1" label="$2" query="$3"
    local got
    got=$(psql_main "$instance" "$query") ||
        fail "$instance" "post-check" "could not query $label"
    [ "$got" = "0" ] ||
        fail "$instance" "post-check" "$label: $got (expected 0)"
}

echo "Products rollout: $IMAGE_TAG"
echo "Instances (in order): ${INSTANCES[*]}"
echo "Planned counts: $EXPECT_FILE"
echo "Logs: $LOG_DIR/"
if [ "$DEPLOY" = false ]; then
    echo ""
    echo "DRY-RUN: preflight only. Nothing is updated, restarted or migrated."
    echo "Add --deploy to roll out."
fi

# Every named instance must appear in the gate's plan file: an instance the
# dry-run never checked is an instance that was never gated.
for INSTANCE in "${INSTANCES[@]}"; do
    if [ -z "$(expected "$INSTANCE" products)" ]; then
        echo "ERROR: '$INSTANCE' has no entry in $EXPECT_FILE, so it was never gated."
        echo "       Run ./validate_consolidation.ts --json $EXPECT_FILE $INSTANCE first."
        exit 1
    fi
done

# Verify the image tag exists on the registry before touching any instance.
if ! sshx "$SSH_HOST" "docker manifest inspect $IMAGE_TAG >/dev/null 2>&1"; then
    echo "ERROR: $IMAGE_TAG not found on the registry. Push it first (./deploy)."
    exit 1
fi

COMPLETED=()

for INSTANCE in "${INSTANCES[@]}"; do
    echo ""
    echo "════════ $INSTANCE ════════"

    # 1. Preflight
    SHOW_JSON=$(sshx "$SSH_HOST" "wb c show $INSTANCE --json") ||
        fail "$INSTANCE" "preflight" "wb c show failed. Does the instance exist? (wb c list)"
    PORT=$(echo "$SHOW_JSON" | jq -r '.port')
    [ -n "$PORT" ] && [ "$PORT" != "null" ] ||
        fail "$INSTANCE" "preflight" "could not determine port from: $SHOW_JSON"

    CURRENT_IMAGE=$(sshx "$SSH_HOST" "docker inspect --format '{{.Config.Image}}' $INSTANCE 2>/dev/null" || true)
    echo "Port $PORT, currently on ${CURRENT_IMAGE:-<not running>}"

    RUNS_SRC=$(sshx "$SSH_HOST" "docker inspect $INSTANCE --format '{{range .Mounts}}{{if eq .Destination \"/app/runs\"}}{{.Source}}{{end}}{{end}}' 2>/dev/null" || true)
    if [ -n "$RUNS_SRC" ]; then
        FREE_GB=$(sshx "$SSH_HOST" "df -BG --output=avail '$RUNS_SRC' | tail -1 | tr -dc '0-9'")
        echo "Runs volume free: ${FREE_GB}G (min ${MIN_FREE_GB}G)"
        [ "$FREE_GB" -ge "$MIN_FREE_GB" ] ||
            fail "$INSTANCE" "preflight" "only ${FREE_GB}G free on $RUNS_SRC (need ${MIN_FREE_GB}G)"
    else
        echo "WARNING: could not resolve the /app/runs mount, skipping the disk check"
    fi

    # The rollback path is the named dump plus the previous image, and the
    # previous image cannot boot after 092. Refuse to migrate an instance
    # whose dump you have not confirmed.
    if [ "$SKIP_BACKUP_CHECK" != "1" ] && [ "$DEPLOY" = true ]; then
        echo ""
        echo "Rollback pre-check for $INSTANCE:"
        echo "  A NAMED status-api dump of 'main' taken from ${CURRENT_IMAGE:-the current image}"
        echo "  must be on disk locally BEFORE this instance is migrated."
        read -r -p "  Confirm the dump exists and ./restore_main was rehearsed [yes/no]: " CONFIRM
        [ "$CONFIRM" = "yes" ] ||
            fail "$INSTANCE" "preflight" "no confirmed rollback dump. Take one, then re-run."
    fi

    echo ""
    echo "  Planned by the dry-run:"
    printf "    %-20s %s\n" "products" "$(expected "$INSTANCE" products)"
    printf "    %-20s %s\n" "slide_decks" "$(expected "$INSTANCE" slideDecks)"
    printf "    %-20s %s\n" "reports" "$(expected "$INSTANCE" reports)"
    printf "    %-20s %s\n" "folders" "$(expected "$INSTANCE" folders)"
    printf "    %-20s %s\n" "slides" "$(expected "$INSTANCE" slides)"
    printf "    %-20s %s\n" "slide_deck_versions" "$(expected "$INSTANCE" slideDeckVersions)"
    printf "    %-20s %s\n" "report_versions" "$(expected "$INSTANCE" reportVersions)"

    if [ "$DEPLOY" = false ]; then
        echo "  DRY-RUN: preflight OK, not deploying."
        COMPLETED+=("$INSTANCE")
        continue
    fi

    # 2. Update and health
    if [ "$CURRENT_IMAGE" = "$IMAGE_TAG" ]; then
        echo "Already on $VERSION, skipping update/restart"
    else
        sshx "$SSH_HOST" "wb c update $INSTANCE --server $VERSION && wb pull && wb restart $INSTANCE" ||
            fail "$INSTANCE" "update" "wb c update / wb pull / wb restart failed"
    fi

    echo "Polling health (timeout ${HEALTH_TIMEOUT_SECONDS}s); the consolidation runs inside this boot..."
    # No sshx retry here: the heredoc stdin is consumed on the first attempt,
    # and a retried empty stdin would make the remote bash exit 0, a FALSE
    # healthy. A 255 here fails the health gate, which is the safe direction.
    if ! command ssh "${SSH_OPTS[@]}" "$SSH_HOST" "PORT='$PORT' TIMEOUT='$HEALTH_TIMEOUT_SECONDS' bash -s" <<'REMOTE'
deadline=$((SECONDS + TIMEOUT))
while [ "$SECONDS" -lt "$deadline" ]; do
    body=$(curl -sfm 5 "http://localhost:$PORT/health_check" || true)
    case "$body" in
        *'"running":true'*) exit 0 ;;
    esac
    sleep 5
done
exit 1
REMOTE
    then
        sshx "$SSH_HOST" "docker logs --tail 120 $INSTANCE" > "$LOG_DIR/$INSTANCE-boot.log" 2>&1 || true
        tail -40 "$LOG_DIR/$INSTANCE-boot.log" || true
        fail "$INSTANCE" "health" "no healthy /health_check within ${HEALTH_TIMEOUT_SECONDS}s. A migration failure fail-stops the boot and rolls the transaction back, so the instance is still on its pre-restructure schema (full log: $LOG_DIR/$INSTANCE-boot.log)"
    fi
    echo "Healthy."

    # Keep the boot log: it carries the per-project 091 consolidate lines.
    sshx "$SSH_HOST" "docker logs --tail 500 $INSTANCE" > "$LOG_DIR/$INSTANCE-boot.log" 2>&1 || true

    RUNNING_IMAGE=$(sshx "$SSH_HOST" "docker inspect --format '{{.Config.Image}}' $INSTANCE")
    [ "$RUNNING_IMAGE" = "$IMAGE_TAG" ] ||
        fail "$INSTANCE" "update" "running image is $RUNNING_IMAGE, expected $IMAGE_TAG"

    # 3. Post-check: the project layer is gone
    PROJECTS_TABLE=$(psql_main "$INSTANCE" "SELECT COALESCE(to_regclass('public.projects')::text, 'dropped')") ||
        fail "$INSTANCE" "post-check" "could not query main"
    [ "$PROJECTS_TABLE" = "dropped" ] ||
        fail "$INSTANCE" "post-check" "the projects table still exists, so migration 092 did not run"

    for MIGRATION in 091_consolidate_projects 092_drop_project_layer; do
        APPLIED=$(psql_main "$INSTANCE" "SELECT count(*) FROM schema_migrations WHERE migration_id = '$MIGRATION'")
        [ "$APPLIED" = "1" ] ||
            fail "$INSTANCE" "post-check" "$MIGRATION is not recorded in schema_migrations"
    done

    # 4. Post-check: counts against the gated plan
    echo "  Actual after migration:"
    check_count "$INSTANCE" "products" "SELECT count(*) FROM products" "$(expected "$INSTANCE" products)"
    check_count "$INSTANCE" "slide_decks" "SELECT count(*) FROM products WHERE type = 'slide_deck'" "$(expected "$INSTANCE" slideDecks)"
    check_count "$INSTANCE" "reports" "SELECT count(*) FROM products WHERE type = 'report'" "$(expected "$INSTANCE" reports)"
    check_count "$INSTANCE" "folders" "SELECT count(*) FROM folders" "$(expected "$INSTANCE" folders)"
    check_count "$INSTANCE" "slides" "SELECT count(*) FROM slides" "$(expected "$INSTANCE" slides)"
    check_count "$INSTANCE" "slide_deck_versions" "SELECT count(*) FROM slide_deck_versions" "$(expected "$INSTANCE" slideDeckVersions)"
    check_count "$INSTANCE" "report_versions" "SELECT count(*) FROM report_versions" "$(expected "$INSTANCE" reportVersions)"

    # The one-transaction rule the DDL cannot express: every registry row has
    # the detail row its type names.
    check_zero "$INSTANCE" "products without a detail row" \
        "SELECT count(*) FROM products p WHERE (p.type = 'slide_deck' AND NOT EXISTS (SELECT 1 FROM slide_decks d WHERE d.id = p.id)) OR (p.type = 'report' AND NOT EXISTS (SELECT 1 FROM reports r WHERE r.id = p.id))"

    echo "$INSTANCE COMPLETE: migrated and post-checked against the gated plan."
    COMPLETED+=("$INSTANCE")
done

echo ""
if [ "$DEPLOY" = false ]; then
    echo "════════ DRY-RUN COMPLETE ════════"
    echo "  Image:       $IMAGE_TAG (not applied)"
    echo "  Preflighted: ${COMPLETED[*]:-none}"
    echo "  Re-run with --deploy to roll out."
else
    echo "════════ PRODUCTS ROLLOUT COMPLETE ════════"
    echo "  Image:       $IMAGE_TAG"
    echo "  Instances:   ${COMPLETED[*]:-none}"
    echo "  Logs:        $LOG_DIR/"
    echo ""
    echo "The legacy project databases are STILL ON DISK: they are the rollback"
    echo "path. Let this settle for days, then run ./purge_legacy_dbs (step 14)."
fi
