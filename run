#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# The container names are machine-global, and a container left by another
# checkout mounts that checkout's data, so always replace both.
export PG_PASSWORD="$(grep '^PG_PASSWORD=' .env | cut -d= -f2-)"
./pg_run >/dev/null
./valkey_run >/dev/null

echo "Waiting for Postgres..."
until docker exec pg pg_isready -U postgres >/dev/null 2>&1; do sleep 0.5; done

deno run --allow-all --env-file --unstable-broadcast-channel main.ts 2>&1 | while IFS= read -r line; do printf "\033[0;32mS:\033[0m %s\n" "$line"; done &
SERVER_PID=$!

(cd client && npm run dev) 2>&1 | while IFS= read -r line; do printf "\033[0;34mC:\033[0m %s\n" "$line"; done &
CLIENT_PID=$!

cleanup() {
  echo "Shutting down..."
  kill $SERVER_PID $CLIENT_PID 2>/dev/null
  docker stop pg valkey-local >/dev/null 2>&1
  exit
}

trap cleanup INT TERM

wait
