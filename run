#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# The container names are machine-global, and a container left by another
# checkout mounts that checkout's data, so always replace both.
export PG_PASSWORD="$(grep '^PG_PASSWORD=' .env | cut -d= -f2-)"
./pg_run >/dev/null
./valkey_run >/dev/null

echo "Waiting for Postgres..."
until docker exec pg pg_isready -U postgres >/dev/null 2>&1; do sleep 0.5; done

colorize() {
  while IFS= read -r line; do printf "\033[0;%sm%s:\033[0m %s\n" "$1" "$2" "$line"; done
}

# Kill a process and every descendant. `$!` of a pipeline is the reader
# subshell, so the pipelines are process substitutions instead: `$!` is then
# the command itself, and the tree walk reaches npm's vite child.
kill_tree() {
  local child
  for child in $(pgrep -P "$1"); do kill_tree "$child"; done
  kill "$1" 2>/dev/null
}

deno run --allow-all --env-file --unstable-broadcast-channel main.ts > >(colorize 32 S) 2>&1 &
SERVER_PID=$!

(cd client && npm run dev) > >(colorize 34 C) 2>&1 &
CLIENT_PID=$!

cleanup() {
  echo "Shutting down..."
  kill_tree $SERVER_PID
  kill_tree $CLIENT_PID
  docker stop pg valkey-local >/dev/null 2>&1
  exit
}

trap cleanup INT TERM

wait
