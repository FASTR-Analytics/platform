#!/bin/bash

# S9 query test rig — seeds declarative fixtures as throwaway RESULTS PACKAGES
# (parquet + manifest) and runs the PRODUCTION run-read machinery in ./server
# against them. Companion to ./validate_migrations, which proves base schema ≡
# base + migrations.
#
# No container: the read plane is DuckDB-over-parquet, which is in-process, so
# the rig needs nothing but a scratch directory.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RIG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/wb-fastr-query-rig.XXXXXX")"

cleanup() {
    rm -rf "$RIG_DIR"
}

trap cleanup EXIT

fail() {
    echo ""
    echo -e "\033[91m╔══════════════════════════════════════════════════════════════╗"
    echo "║                  QUERY VALIDATION FAILED                     ║"
    echo "║                                                              ║"
    printf "║  %-60s║\n" "$1"
    echo -e "╚══════════════════════════════════════════════════════════════╝\033[0m"
}

# Importing the server modules pulls in exposed_env_vars.ts, which reads
# Deno.env at module load and throws on anything missing. These are dummies —
# the real .env is deliberately NOT sourced, so the rig cannot reach a live
# database or a live instance's results packages even by accident. Packages are
# written under SANDBOX_DIR_PATH (= _RUNS_DIR_PATH), which is the scratch dir
# above and is deleted on exit.
export INSTANCE_NAME="query_rig"
export INSTANCE_ID="query_rig"
export INSTANCE_LANGUAGE="en"
# The process calendar reaches the query engine through nothing at all — a
# package carries its own calendar in the manifest — so this is only here to
# satisfy the boot-time env check.
export INSTANCE_CALENDAR="gregorian"
# Not NGA: Nigeria triggers format_nigeria_admin_label's special-case admin-area
# label cleaning, which would silently shift query-case expectations.
export ISO_COUNTRY_CODE="KEN"
export SANDBOX_DIR_PATH="$RIG_DIR/packages"
export SANDBOX_DIR_PATH_EXTERNAL="$RIG_DIR/packages"
export SANDBOX_DIR_PATH_POSTGRES_INTERNAL="$RIG_DIR/packages"
export ASSETS_DIR_PATH="$RIG_DIR/assets"
export DATABASE_FOLDER="$RIG_DIR/databases"
export PG_HOST="127.0.0.1"
export PG_PORT="1"
export PG_PASSWORD="unused"
export ANTHROPIC_API_URL="http://localhost:0"
export ANTHROPIC_API_KEY="unused"
export STATUS_API_KEY="unused"
export SEND_GRID_API="unused"
export SERVER_VERSION="0.0.0-query-rig"

echo "Typechecking rig..."
if ! deno check -c "$SCRIPT_DIR/deno.json" "$SCRIPT_DIR/query_rig/mod.ts"; then
    fail "The query rig does not typecheck."
    exit 1
fi

echo ""
if ! deno run --allow-all -c "$SCRIPT_DIR/deno.json" "$SCRIPT_DIR/query_rig/mod.ts"; then
    fail "One or more query cases failed. See above."
    exit 1
fi

echo ""
echo -e "\033[92m╔══════════════════════════════════════════════════════════════╗"
echo "║                  QUERY VALIDATION PASSED                     ║"
echo -e "╚══════════════════════════════════════════════════════════════╝\033[0m"
