#!/bin/bash

# S9 query test rig — builds a REAL results package per declarative fixture
# (the production parquet writer + package builder) into a throwaway runs
# directory and runs the PRODUCTION run read path in ./server against it.
# A throwaway Postgres serves only what the package builder reads from the
# MAIN database (the per-family structure schema rows). Companion to
# ./validate_migrations, which proves base schema ≡ base + migrations (this rig
# therefore loads only the base schema file).

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONTAINER_NAME="wb-fastr-query-rig-$$"
DB_PORT=54330
DB_PASS="testpass"
RUNS_DIR="$(mktemp -d /tmp/query_rig_runs_XXXXXX)"

cleanup() {
    echo "Cleaning up..."
    docker stop "$CONTAINER_NAME" 2>/dev/null || true
    docker rm -v "$CONTAINER_NAME" 2>/dev/null || true
    rm -rf "$RUNS_DIR"
}

trap cleanup EXIT

fail() {
    echo ""
    echo -e "\033[91m╔══════════════════════════════════════════════════════════════╗"
    echo "║                  QUERY VALIDATION FAILED                     ║"
    echo "║                                                              ║"
    printf "║  %-60s║\n" "$1"
    echo -e "╚══════════════════════════════════════════════════════════════╝\033[0m"
}

echo "Starting temporary postgres container..."
docker run -d \
    --name "$CONTAINER_NAME" \
    -e POSTGRES_PASSWORD="$DB_PASS" \
    -p "$DB_PORT:5432" \
    postgres:17.4 > /dev/null

echo "Waiting for postgres to be ready..."
for i in {1..30}; do
    if docker exec "$CONTAINER_NAME" pg_isready -U postgres > /dev/null 2>&1; then
        break
    fi
    sleep 0.5
done

# Importing server/db/mod.ts pulls in exposed_env_vars.ts, which reads Deno.env
# at module load and throws on anything missing. These are dummies pointing at
# the throwaway container — the real .env is deliberately NOT sourced, so the
# rig cannot reach a live database even by accident.
export INSTANCE_NAME="query_rig"
export INSTANCE_ID="query_rig"
export INSTANCE_LANGUAGE="en"
export INSTANCE_CALENDAR="gregorian"
# Not NGA: Nigeria triggers format_nigeria_admin_label's special-case admin-area
# label cleaning, which would silently shift query-case expectations.
export ISO_COUNTRY_CODE="KEN"
export SANDBOX_DIR_PATH="$RUNS_DIR"
export SANDBOX_DIR_PATH_EXTERNAL="$RUNS_DIR"
export SANDBOX_DIR_PATH_POSTGRES_INTERNAL="$RUNS_DIR"
export QUERY_RIG_RUNS_DIR="$RUNS_DIR"
export ASSETS_DIR_PATH="/tmp/query_rig/assets"
export DATABASE_FOLDER="/tmp/query_rig/databases"
export PG_HOST="127.0.0.1"
export PG_PORT="$DB_PORT"
export PG_PASSWORD="$DB_PASS"
export ANTHROPIC_API_URL="http://localhost:0"
export ANTHROPIC_API_KEY="unused"
export STATUS_API_KEY="unused"
export SEND_GRID_API="unused"
export SERVER_VERSION="0.0.0-query-rig"

echo "Typechecking rig..."
if ! deno check -c "$SCRIPT_DIR/deno.json" "$SCRIPT_DIR/query_rig/mod.ts"; then
    fail "The query rig does not typecheck."
    exit 1
fi

echo ""
if ! deno run --allow-all -c "$SCRIPT_DIR/deno.json" "$SCRIPT_DIR/query_rig/mod.ts"; then
    fail "One or more query cases failed. See above."
    exit 1
fi

echo ""
echo -e "\033[92m╔══════════════════════════════════════════════════════════════╗"
echo "║                  QUERY VALIDATION PASSED                     ║"
echo -e "╚══════════════════════════════════════════════════════════════╝\033[0m"
